# Ditto credentials — copy to .env at repository root and fill in values
# Get these from portal.ditto.live
DITTO_APP_ID=your-app-id-here
DITTO_PLAYGROUND_TOKEN=your-playground-token-here
DITTO_AUTH_URL=https://auth.ditto.live
DITTO_WEBSOCKET_URL=wss://cloud.ditto.live

# Firebase: place google-services.json at pubsec/android-firebase-pos/app/google-services.json
# Do NOT commit google-services.json to git
